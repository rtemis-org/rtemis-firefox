{
  "manifest_version": 2,
  "name": "rtemis",
  "version": "1.0",
  "description": "rtemis color theme with system, light, and dark modes, plus a new tab page with clock, weather, search, and optional Hacker News.",
  "homepage_url": "https://github.com/rtemis-org/rtemis-firefox",
  "browser_specific_settings": {
    "gecko": {
      "id": "rtemis@rtemis.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "locationInfo"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/favicon.svg",
    "96": "icons/favicon.svg"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/favicon.svg",
      "32": "icons/favicon.svg"
    },
    "default_title": "rtemis",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "theme",
    "storage",
    "search"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  }
}
