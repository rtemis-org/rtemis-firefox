{
  "manifest_version": 2,
  "name": "rtemis",
  "version": "1.0.2",
  "description": "rtemis color theme with system, light, and dark modes, plus a new tab page with clock, weather, search, and optional Hacker News and Slashdot.",
  "homepage_url": "https://github.com/rtemis-org/rtemis-firefox",
  "browser_specific_settings": {
    "gecko": {
      "id": "rtemis@rtemis.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "locationInfo"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/logomark.svg",
    "96": "icons/logomark.svg"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/logomark.svg",
      "32": "icons/logomark.svg"
    },
    "default_title": "rtemis",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": [
      "background.js",
      "page-windows.js"
    ]
  },
  "permissions": [
    "theme",
    "storage",
    "search",
    "menus",
    "https://rss.slashdot.org/*"
  ],
  "commands": {
    "return-to-regular-window": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Return to regular window without reloading"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  }
}
