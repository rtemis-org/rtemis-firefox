{
  "manifest_version": 2,
  "name": "rtemis",
  "version": "2.1",
  "description": "rtemis theme with light and dark modes, and a new tab page with weather and clock",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "rtemis",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": [
      "styles.js"
    ]
  },
  "permissions": [
    "theme",
    "storage",
    "search"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  }
}
